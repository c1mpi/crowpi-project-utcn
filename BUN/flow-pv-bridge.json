        "z": "pvtab0000000001",
        "name": "doar comenzi permise",
        "func": "// Pagina trimite {\"topic\":\"ventilator\",\"val\":\"true\"} sau {\"topic\":\"admin\",\"val\":\"logout\"}.\n// Trec doar aceste două comenzi; Raspberry Pi verifică singur dacă e un admin logat cu RFID.\nlet c;\ntry { c = JSON.parse(msg.payload); } catch (e) { return null; }\nconst permise = { ventilator: \"scada/comanda/ventilator\", admin: \"scada/comanda/admin\" };\nif (!c || !permise[c.topic]) return null;\nreturn { topic: permise[c.topic], payload: String(c.val) };",
